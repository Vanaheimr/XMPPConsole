<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      What is checked here is the console and nothing else: the protocol has
      its own suite in Ratatoskr, and everything that needs a foreign
      implementation lives in XMPPConformanceTests, next to the setups that
      produce those far sides.
    -->
    <RootNamespace>org.GraphDefined.Vanaheimr.XMPPConsole.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.XMPPConsole.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XMPPConsole\XMPPConsole.csproj" />
  </ItemGroup>

</Project>
