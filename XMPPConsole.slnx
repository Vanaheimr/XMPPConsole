<Solution>
  <!--
    Everything here is inside the repository, because everything here is
    pinned: libs/ holds Styx, Hermod and Ratatoskr as submodules, and a clone
    that recurses into them is enough to open this and build it.

    Their test suites are named too, the way TCPEchoTestClient and
    XMPPConformanceTests name theirs. Running them from here measures the
    revisions this repository pins, so a red result says which one - which is
    only true because they are pinned. The console's own gate stays narrower:
    the CI builds and runs XMPPConsole.Tests alone, and the protocol's suite
    answers for the protocol.
  -->
  <Folder Name="/Dependencies/">
    <Project Path="libs/Hermod/Hermod/Hermod.csproj" />
    <Project Path="libs/Hermod/HermodTests/HermodTests.csproj" />
    <Project Path="libs/Ratatoskr/Ratatoskr/Ratatoskr.csproj" />
    <Project Path="libs/Ratatoskr/RatatoskrTests/RatatoskrTests.csproj" />
    <Project Path="libs/Styx/Styx/Styx.csproj" />
    <Project Path="libs/Styx/StyxTests/StyxTests.csproj" />
  </Folder>
  <Project Path="XMPPConsole/XMPPConsole.csproj" />
  <Project Path="XMPPConsole.Tests/XMPPConsole.Tests.csproj" />
</Solution>
